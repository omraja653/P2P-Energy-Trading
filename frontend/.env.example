# Relative by default (dev-server proxy in vite.config.js forwards /api to
# the backend) — only override with an absolute URL for a real deployment
# where frontend and backend are on different hosts.
VITE_API_URL=/api
# Same-origin by default (see services/socket.js) — required once
# frontend/backend are on different origins (e.g. a Vercel frontend +
# Render backend), same as VITE_API_URL above. Set to the backend's
# origin only, no /api suffix — Socket.io's own path is separate from
# the REST API's base path. Leave unset for local dev (Vite's
# /socket.io proxy entry handles it).
VITE_WS_URL=
VITE_ENERGY_TRADE_CONTRACT_ADDRESS=0x
VITE_POLYGON_AMOY_CHAINID=80002
VITE_POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Google OAuth client ID — safe to expose in frontend code (only the client
# secret, kept backend-only, is sensitive). Must match backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
# Razorpay key_id (public, safe to expose client-side — the secret stays
# backend-only in backend/.env). Test mode only.
VITE_RAZORPAY_KEY_ID=
