PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/energy-trading
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d

POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
ENERGY_TRADE_CONTRACT_ADDRESS=0x
ENERGY_TRADE_ABI=[]
# Settlement.sol — see backend/config/blockchain.js for why its ABI is a
# small hand-written fragment here instead of a full compiled-artifact env var.
SETTLEMENT_CONTRACT_ADDRESS=0x
GRID_OPERATOR_ADDRESS=0x
PLATFORM_WALLET_ADDRESS=0x
PLATFORM_PRIVATE_KEY=

SMART_METER_SIMULATOR=true

# Double-auction cadence — how often a trading round closes and clears
# (jobs/auctionScheduler.js). Optional; defaults to 120000 (2 min).
AUCTION_INTERVAL_MS=120000

# Daily "trading market is open" reminder email (jobs/morningEmailJob.js).
# Sends once per day to every ACTIVE consumer/prosumer who hasn't used the
# unsubscribe link. Falls back to console logging when Brevo isn't
# configured (same as OTP email). Set MORNING_EMAIL_ENABLED=false to turn
# it off entirely.
MORNING_EMAIL_ENABLED=true
MORNING_EMAIL_HOUR_IST=7          # 0-23, hour of day (IST) to send; default 7
# Public URLs used to build the links inside the email:
FRONTEND_URL=http://localhost:5173   # marketplace / orders links
API_PUBLIC_URL=http://localhost:5000 # unsubscribe link (served by this API)

OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# OTP delivery — registration falls back to logging OTPs to the server
# console when these are unset, so registration works locally without them.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
# Brevo (https://brevo.com) transactional email — free tier, 300/day.
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Google login (ID-token verification, not Passport/OAuth-redirect).
# GOOGLE_CLIENT_SECRET isn't used by this flow (no server-side code
# exchange) but is included for future use / if you add one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (test mode) — wallet top-up only. Test keys, not live payment
# credentials; get your own from https://dashboard.razorpay.com/app/keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
